{
  "name": "ffb-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "description": "Draft-tracker web app (Cloudflare Worker) consuming ffb board.json v1",
  "type": "module",
  "scripts": {
    "build:client": "esbuild public/app.ts public/mock-app.ts --bundle --format=iife --target=es2022 --outdir=public --entry-names=[name]",
    "bench:search": "vitest bench --config vitest.bench.config.ts player-pool --run",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "test": "vitest run",
    "test:browser": "npm run build:client && playwright test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "publish:board": "wrangler kv key put --binding BOARD board:current --path ../exports/board.json --local --preview",
    "publish:board:remote": "wrangler kv key put --binding BOARD board:current --path ../exports/board.json --remote --preview false"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260721.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.103.0"
  }
}
